DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
INSTITUTIONAL_EMAIL_DOMAIN=iskolarngbayan.pup.edu.ph
# Production must override this with a persistent path outside all web-server
# document roots and public aliases; see the private-storage deployment notes.
PRIVATE_COR_STORAGE_ROOT=../private_cor_storage
# Local development only. When DJANGO_DEBUG=False, set EMAIL_BACKEND to a
# non-console backend such as django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Curator <noreply@localhost>
DATABASE_ENGINE=sqlite

# Optional PostgreSQL configuration. PostgreSQL must be explicitly selected.
# Remote PostgreSQL connections default to sslmode=verify-full.
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=curator_forum
# POSTGRES_USER=curator_dev
# POSTGRES_PASSWORD=replace-with-your-local-database-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_TEST_DB=curator_forum_test
# POSTGRES_SSLMODE=verify-full  # default for remote hosts; omit for loopback
# POSTGRES_SSLROOTCERT=/path/to/postgresql-ca.crt
